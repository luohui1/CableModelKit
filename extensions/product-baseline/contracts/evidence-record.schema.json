{
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "notes": {
      "default": "",
      "maxLength": 2000,
      "title": "Notes",
      "type": "string"
    },
    "reference": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference"
    },
    "revision": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision"
    },
    "scope": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Scope",
      "type": "array"
    },
    "source_type": {
      "enum": [
        "manufacturer_drawing",
        "manufacturer_catalog",
        "public_reference",
        "user_dimensions",
        "synthetic_demo"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "verification": {
      "default": "unverified",
      "enum": [
        "unverified",
        "verified"
      ],
      "title": "Verification",
      "type": "string"
    }
  },
  "required": [
    "id",
    "source_type",
    "scope"
  ],
  "title": "EvidenceRecord",
  "type": "object"
}
